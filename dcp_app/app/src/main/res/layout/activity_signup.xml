<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#333333"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="회원가입"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText android:hint="Name" android:layout_marginTop="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:hint="PH" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:hint="E-mail" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:hint="Password" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnSignupConfirm"
            android:text="회원가입"
            android:layout_marginTop="32dp"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
