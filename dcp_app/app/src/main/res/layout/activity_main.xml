<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#444444">

    <!-- 타이틀 -->

    <!-- 메뉴 아이콘 -->

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="176dp"
        android:text="시간표"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 정보 아이콘 -->

    <!-- 시간표 그리드 -->

    <ImageView
        android:id="@+id/menuIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="90dp"
        android:contentDescription="메뉴"
        android:src="@drawable/setting"
        app:layout_constraintBottom_toTopOf="@+id/btnInfo"
        app:layout_constraintEnd_toEndOf="@+id/btnInfo"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btnInfo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="160dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="정보"
        android:src="@drawable/infosetting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <GridLayout
        android:id="@+id/timeTableGrid"
        android:layout_width="371dp"
        android:layout_height="552dp"
        android:background="@drawable/bg_table_corner"
        android:columnCount="6"
        android:orientation="horizontal"
        android:padding="2dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 헤더 Row -->
        <TextView
            style="@style/DayCell"
            android:layout_width="55dp"
            android:text="비고" />
        <TextView style="@style/DayCell" android:text="월" />
        <TextView style="@style/DayCell" android:text="화" />
        <TextView style="@style/DayCell" android:text="수" />
        <TextView style="@style/DayCell" android:text="목" />
        <TextView style="@style/DayCell" android:text="금" />

        <!-- 각 시간 행 (9시 ~ 4시) -->
        <TextView style="@style/TimeCell" android:text="9" />
        <TextView android:id="@+id/cell_9_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_9_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_9_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_9_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_9_5" style="@style/TableCell" />

        <TextView style="@style/TimeCell" android:text="10" />
        <TextView android:id="@+id/cell_10_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_10_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_10_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_10_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_10_5" style="@style/TableCell" />

        <TextView style="@style/TimeCell" android:text="11" />
        <TextView android:id="@+id/cell_11_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_11_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_11_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_11_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_11_5" style="@style/TableCell" />

        <TextView style="@style/TimeCell" android:text="12" />
        <TextView android:id="@+id/cell_12_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_12_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_12_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_12_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_12_5" style="@style/TableCell" />

        <TextView style="@style/TimeCell" android:text="1" />
        <TextView android:id="@+id/cell_13_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_13_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_13_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_13_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_13_5" style="@style/TableCell" />

        <TextView style="@style/TimeCell" android:text="2" />
        <TextView android:id="@+id/cell_14_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_14_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_14_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_14_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_14_5" style="@style/TableCell" />

        <TextView style="@style/TimeCell" android:text="3" />
        <TextView android:id="@+id/cell_15_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_15_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_15_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_15_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_15_5" style="@style/TableCell" />

        <TextView style="@style/TimeCell" android:text="4" />
        <TextView android:id="@+id/cell_16_1" style="@style/TableCell" />
        <TextView android:id="@+id/cell_16_2" style="@style/TableCell" />
        <TextView android:id="@+id/cell_16_3" style="@style/TableCell" />
        <TextView android:id="@+id/cell_16_4" style="@style/TableCell" />
        <TextView android:id="@+id/cell_16_5" style="@style/TableCell" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>