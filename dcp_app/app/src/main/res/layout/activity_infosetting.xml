<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#444444">

    <!-- 상단 Guideline -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="80dp" />

    <!-- 교양/필수 + (조건부) extraFilter -->
    <TextView
        android:id="@+id/label_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="교양/필수"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/type"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:entries="@array/type"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        app:layout_constraintStart_toEndOf="@id/label_type"
        app:layout_constraintBaseline_toBaselineOf="@id/label_type"
        android:layout_marginStart="8dp"/>

    <Spinner
        android:id="@+id/lectureArea"
        android:layout_width="120dp"
        android:layout_height="48dp"
        android:entries="@array/lecture_area"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        app:layout_constraintStart_toEndOf="@id/type"
        app:layout_constraintBaseline_toBaselineOf="@id/type"
        android:layout_marginStart="8dp"/>

    <!-- 학과/학년 한 줄 -->
    <LinearLayout
        android:id="@+id/row_dept_grade"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical">

        <!-- 학과/학년 라벨 -->
        <TextView
            android:id="@+id/label_dept_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학과/학년"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginEnd="12dp"
            android:labelFor="@id/dept"/>

        <!-- 학과 입력 -->
        <EditText
            android:id="@+id/dept"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:hint="학과"
            android:inputType="text"
            android:textColor="@color/black"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>

        <!-- 학년 선택 -->
        <Spinner
            android:id="@+id/grade"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:entries="@array/grade"
            android:backgroundTint="#fff"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- 시간 설정 -->
    <TextView
        android:id="@+id/label_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="시간"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/row_dept_grade"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"/>

    <Spinner
        android:id="@+id/days"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:entries="@array/days_array"
        app:layout_constraintTop_toBottomOf="@id/row_dept_grade"
        app:layout_constraintStart_toEndOf="@id/label_time"
        app:layout_constraintBaseline_toBaselineOf="@id/label_time"
        android:layout_marginStart="8dp"/>
<!--    @string/start_time_hint (hint 원본)-->
    <EditText
        android:id="@+id/editStartTime"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:hint="1"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/row_dept_grade"
        app:layout_constraintStart_toEndOf="@id/days"
        app:layout_constraintBaseline_toBaselineOf="@id/days"
        android:layout_marginStart="8dp"/>

    <!--    @string/end_time_hint (hint 원본)-->
    <EditText
        android:id="@+id/editEndTime"
        android:layout_width="60dp"
        android:layout_height="48dp"
        android:hint="2"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/row_dept_grade"
        app:layout_constraintStart_toEndOf="@id/editStartTime"
        app:layout_constraintBaseline_toBaselineOf="@id/editStartTime"
        android:layout_marginStart="8dp"/>

    <!-- 건물/강의실 + 건물검색필터 -->
    <TextView
        android:id="@+id/label_building"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="건물/강의실"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/editEndTime"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"/>

    <Spinner
        android:id="@+id/generalArea"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:entries="@array/general_area"
        app:layout_constraintTop_toBottomOf="@id/editEndTime"
        app:layout_constraintStart_toEndOf="@id/label_building"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/label_building"
        android:layout_marginStart="8dp"/>

    <!--    @string/search (text 원본)-->
    <!-- 검색 버튼 -->
    <Button
        android:id="@+id/btnSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="검색"
        android:backgroundTint="#3F51B5"
        android:textColor="#fff"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/generalArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- 결과 컨테이너 -->
    <LinearLayout
        android:id="@+id/resultContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/btnSearch"
        app:layout_constraintBottom_toTopOf="@id/btnExit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- 나가기 버튼 -->
    <Button
        android:id="@+id/btnExit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_exit"
        android:backgroundTint="#FFFFFF"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
