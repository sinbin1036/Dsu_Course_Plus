<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 내부 색상 (배경색) -->
    <solid android:color="#444444" />

    <!-- 외곽선 선 색상과 두께 -->
    <stroke
        android:width="1dp"
        android:color="#000000" />

    <!-- 둥근 모서리 반지름 -->
    <corners android:radius="12dp" />

</shape>